{
  "expo": {
    "name": "痘痘日记",
    "slug": "acne-diary",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.personal.acnediary",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "拍摄皮肤记录照片",
        "NSPhotoLibraryUsageDescription": "选择皮肤记录照片"
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.personal.acnediary",
      "permissions": [],
      "allowBackup": false,
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#244D43"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择皮肤记录照片",
          "cameraPermission": "拍摄皮肤记录照片",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
